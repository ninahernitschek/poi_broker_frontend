# example private & local settings 
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_TESTING=True
SECRET_KEY="REPLACE_WITH_RANDOM_SECRET_KEY"
ALERTS_DB_PATH="../_broker_db/ztf_alerts_stream.db"
USERS_DB_PATH="../_broker_db/users.db"
# example production settings
#FLASK_ENV=production
#FLASK_DEBUG=False
#FLASK_TESTING=False
# example secret key for authenticated SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="REPLACE_WITH_EMAIL_ADDRESS"
SMTP_APP_PASSWORD="REPLACE_WITH_APP_PASSWORD"
#SMTP_SUBJECT="Notification from POI Broker"
#SMTP_FROM #to set "from" email address alias, if different from SMTP_USER
#LOCAL_HOST=localhost OR poibroker.uantof.cl #used for SMTPLib to improve email deliverability
# Canonical public origin for verification/reset emails (required in production)
#PUBLIC_BASE_URL=https://poibroker.example.edu
# Session and cookie settings
#SESSION_COOKIE_SECURE=False
#REMEMBER_COOKIE_SECURE=False
#SESSION_COOKIE_SAMESITE=Lax
#REMEMBER_COOKIE_SAMESITE=Lax
#SESSION_LIFETIME_HOURS=24
# Rate limiting settings
#RATELIMIT_ENABLED=True
# memory:// is per-process; multi-worker Gunicorn needs a shared backend URI
#RATELIMIT_STORAGE_URI=memory://
#AUTH_RATE_LIMIT_LOGIN=10 per minute
#AUTH_RATE_LIMIT_SIGNUP=5 per hour
#AUTH_RATE_LIMIT_FORGOT_PASSWORD=5 per hour
#AUTH_RATE_LIMIT_RESET_PASSWORD=10 per hour
#AUTH_RATE_LIMIT_CHANGE_PASSWORD=10 per hour
#AUTH_RATE_LIMIT_VERIFY_EMAIL=10 per hour
# Optional catalog counts stop after this SQLite execution budget.
# Set to 0 to hide and disable the Count action on slower deployments.
#CATALOG_COUNT_BUDGET_SECONDS=2.0
HUEY_BACKEND=sqlite
# Required with sqlite: absolute path shared by web app and huey_consumer worker.
# No fallback exists at import time; an unset path fails fast instead of
# silently creating a second empty queue database.
HUEY_SQLITE_PATH="/var/lib/poi_broker/huey.db"
# Export feature settings
#EXPORT_RETENTION_DAYS=10          # delete exports (CSV + DB row) older than this
#EXPORT_STALE_MAX_AGE_SECONDS=1800 # fail exports stuck PENDING/RUNNING this long
#EXPORT_HEARTBEAT_SECONDS=60       # RUNNING exports refresh updated_at this often
# Keep EXPORT_STALE_MAX_AGE_SECONDS >= 2 * EXPORT_HEARTBEAT_SECONDS (defaults 1800 vs 60)
#EXPORT_MAX_ROWS=1000000           # max rows a single export may return
